# =====================================================================
#  E-ARSIPKU — Template .env untuk PRODUKSI (shared hosting / cPanel)
#  Salin menjadi .env di server, lalu isi nilai yang bertanda <ISI>.
#  JANGAN commit .env asli ke Git.
# =====================================================================

APP_NAME="E-ARSIPKU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<DOMAIN-ANDA>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log: harian, buang yang lama otomatis. Jangan pakai level debug di produksi.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Basis Data (buat via cPanel ▸ MySQL Databases) ───────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<NAMA_DB>
DB_USERNAME=<USER_DB>
DB_PASSWORD=<PASSWORD_DB>

# Sesi & antrean pakai database (tanpa Redis di shared hosting).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan agar cookie sesi hanya lewat HTTPS (setelah SSL terpasang):
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email (opsional; untuk notifikasi/reset bila dipakai) ────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<DOMAIN-ANDA>"
MAIL_FROM_NAME="${APP_NAME}"

# ── Unggahan Berkas ──────────────────────────────────────────────────
# Batas ukuran diatur di PHP (.user.ini) — lihat DEPLOY.md.

# ── OCR (Tesseract/Ghostscript) ──────────────────────────────────────
# Shared hosting umumnya TIDAK punya Tesseract/Ghostscript → matikan agar
# unggah tidak lambat. PDF berbasis teks tetap terekstrak (murni PHP).
OCR_AKTIF=false

# ── Saran Metadata Otomatis (AI) ─────────────────────────────────────
# Aktif; cukup isi kunci API. Bekerja pada teks berkas (PDF teks/OCR).
AI_METADATA_AKTIF=true
ANTHROPIC_API_KEY=<KUNCI_API_ANTHROPIC>
AI_METADATA_MODEL=claude-opus-4-8

# ── Backup Basis Data (dijadwalkan 23.00 via cron schedule:run) ──────
BACKUP_KEEP=14
# Bila mysqldump tidak di PATH server, isi path lengkapnya:
# BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump

VITE_APP_NAME="${APP_NAME}"
